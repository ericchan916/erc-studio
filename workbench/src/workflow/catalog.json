  "routes": [
    {
      "id": "route:daily-task-checkin",
      "routeId": "daily-task-checkin",
      "name": "日报登记",
      "kind": "workflow",
      "group": "业务流程",
      "trigger": "工作群@你汇报当天工作；当天提醒已发出时无需前缀，补录必须说明日期；上一轮正在确认结束日期时，用户的确认或修改回复继续该流程；后台保留09:00追问与22:30提醒",
      "action": "完整分页读取并查重任务总表；缺少结束日期时Agent先提议具体日期，用户确认后才写入；缺少目标时先建立目标再关联；写后重新读取结束日期校验",
      "boundary": "只登记OWNER或OPERATOR真实陈述的工作；结束日期未确认时不写表，不把其他讨论、提问或指令当日报",
      "dependencies": [
        "daily_task",
        "bridge"
      ],
      "source": "integrations/agent-runtime/workflow-registry.json",
      "verification": "单次业务结果需原流程回执；依赖健康不等于业务成功",
      "receipts": [
        {
          "path": "ContentBaseDailyTask/daily_task_checkin.db",
          "table": "report_runs",
          "column": "status",
          "where": {},
          "mode": "state",
          "timeField": "updated_at"
        }
      ],
      "receipt_boundary": "原流程技术回执聚合；不代表飞书字段或平台公开状态已重新核验"
    },
    {
      "id": "route:task-deadline-followup",
      "routeId": "task-deadline-followup",
      "name": "任务截止日期追问",
      "kind": "workflow",
      "group": "业务流程",
      "trigger": "后台每小时检查任务总表，在10:00后处理已到任务周期中点或截止前3天的未完成任务",
      "action": "通过统一通知中心向工作群发送CardKit，在卡片内真实@该任务的所有负责人并询问完成情况",
      "boundary": "只读任务表并发送去重提醒，不自动修改完成度、截止日期或负责人；首次部署不补发历史节点",
      "dependencies": [
